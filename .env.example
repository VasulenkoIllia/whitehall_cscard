# ─── Database (docker-compose підставляє автоматично через environment:) ───────
DATABASE_URL=postgres://whitehall_store:whitehall_store@db:5432/whitehall_store

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Auth ─────────────────────────────────────────────────────────────────────
AUTH_STRATEGY=db
# Мінімум 32 символи, генерувати: openssl rand -hex 32
AUTH_SESSION_SECRET=ЗАМІНИ_НА_РАНДОМНИЙ_РЯДОК_openssl_rand_hex_32
AUTH_SESSION_TTL_MINUTES=720

# Використовується ТІЛЬКИ для npm run seed:users (один раз при деплої).
# Після того як запустив seed — можна залишити або очистити.
# Як згенерувати хеш пароля: npm run hash-password ТвійПароль
AUTH_USERS_JSON='[
  {"email":"admin1@example.com","password_hash":"$2a$12$...","role":"admin"},
  {"email":"admin2@example.com","password_hash":"$2a$12$...","role":"admin"},
  {"email":"viewer@example.com","password_hash":"$2a$12$...","role":"viewer"}
]'

# ─── Google Sheets (для імпорту даних від постачальників) ────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# ─── Прайс покупцям (дроп-ціни) у Google Sheet ───────────────────────────────
# Вивантаження прайсу покупцям (Артикул/Назва/Розмір/Кількість/Ціна=дроп).
# Дроп = CEIL((базова+фінальна)/2/10)*10. Джерело — products_final (quantity>0).
# Прив'язано до події завершення finalize (авто-крок у update_pipeline), плюс
# ручна кнопка «Ручне керування». Повне перезаписування вкладки.
# УВАГА: сервіс-акаунт (GOOGLE_CLIENT_EMAIL) має бути РЕДАКТОРОМ цієї таблиці.
# _ENABLED вмикає лише АВТО-крок після finalize. Ручна кнопка/CLI працюють,
# щойно задано BUYER_PRICE_SHEET_ID (незалежно від _ENABLED).
BUYER_PRICE_EXPORT_ENABLED=false          # true = авто-крок після finalize
BUYER_PRICE_SHEET_ID=                      # ID/URL цільової таблиці
BUYER_PRICE_SHEET_TAB=Прайс                # назва бойової вкладки
# BUYER_PRICE_BATCH_ROWS=10000             # рядків на один запис у Google
# BUYER_PRICE_TIMEOUT_MS=180000            # хард-таймаут запису

# ─── CS-Cart store ────────────────────────────────────────────────────────────
CSCART_URL=https://your-store.com
CSCART_API_ID=your_api_id
CSCART_API_KEY=your_api_key

# ID характеристики "Колекція + Модель" у CS-Cart (product_features.<id>.value).
# Використовується для денормалізованого поля collection_code у store_mirror
# та для нової колонки "Колекція в магазині" у вкладці Порівняння.
# Для прод-магазину whitehall.com.ua = 558.
CSCART_COLLECTION_FEATURE_ID=558

# Запобіжники проти роботи з неповним дзеркалом магазину.
#
# STORE_MIRROR_MAX_PRUNE_RATIO — яку частку store_mirror знімок має право
# видалити за один прогін. Знімок, що не побачив більшість каталогу, зламаний
# (паралельний синк, обірваний обхід), і замість тихої зачистки дзеркала job
# падає з помилкою. За замовчуванням 0.2.
#
# CSCART_MAX_MISSING_IN_MIRROR_RATIO — яка частка фінальних товарів може бути
# відсутня в дзеркалі, перш ніж store_import відмовиться відправляти. У нормі
# на цьому каталозі ~37% SKU справді не існує в магазині (allowCreate=false),
# при зламаному дзеркалі — ~99%. За замовчуванням 0.8.
# STORE_MIRROR_MAX_PRUNE_RATIO=0.2
# CSCART_MAX_MISSING_IN_MIRROR_RATIO=0.8

# ─── Active store connector ───────────────────────────────────────────────────
ACTIVE_STORE=cscart
